# Copy this file to .env.admin and fill in the real values.
# .env.admin is in .gitignore -- it will never be committed or pushed to GitHub.
#
# SUPABASE_URL: same value as VITE_SUPABASE_URL in your .env file
# SUPABASE_SERVICE_ROLE_KEY: found in Supabase dashboard -> Project Settings -> API
#   -> "service_role" secret key (NOT the anon/public key).
#   This key bypasses all security rules -- never share it, never commit it,
#   never put it in the app's own .env file.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-your-service-role-key-here
